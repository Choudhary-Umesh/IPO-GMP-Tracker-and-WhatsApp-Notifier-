# Copy to .env for LOCAL testing only. NEVER commit .env.
# In production these live in GitHub -> Settings -> Secrets and variables -> Actions.

WHATSAPP_PROVIDER=callmebot

# --- CallMeBot (recommended, free forever) ---
CALLMEBOT_PHONE=+919876543210
CALLMEBOT_APIKEY=1234567

# --- Twilio WhatsApp Sandbox (alternative) ---
# WHATSAPP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_FROM=whatsapp:+14155238886
# TWILIO_TO=whatsapp:+919876543210

# --- Tuning (optional) ---
MIN_GMP_PCT=15
FUZZY_THRESHOLD=80
SEND_WHEN_EMPTY=true
USE_PLAYWRIGHT=false
