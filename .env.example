# Copy to .env for LOCAL testing only. NEVER commit .env (it is in .gitignore).
# In production these live in GitHub -> Settings -> Secrets and variables -> Actions.

# telegram (current), meta, callmebot, twilio, or auto
WHATSAPP_PROVIDER=telegram
# Optional second channel if WhatsApp delivery fails (e.g. telegram)
FALLBACK_PROVIDER=

# --- Option A: Meta WhatsApp Cloud API (official) ---
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_TO=919876543210
META_WA_TEMPLATE=ipo_daily_alert
META_WA_TEMPLATE_LANG=en

# --- Option B: CallMeBot (free WhatsApp to your own number) ---
CALLMEBOT_PHONE=+919876543210
CALLMEBOT_APIKEY=

# --- Option C: Twilio WhatsApp ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=whatsapp:+14155238886
TWILIO_TO=whatsapp:+919876543210

# --- Telegram (good FALLBACK_PROVIDER) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Tuning (optional) ---
MIN_GMP_PCT_SME=40
MIN_GMP_PCT_MAINBOARD=15
FUZZY_THRESHOLD=80
SEND_WHEN_EMPTY=true
SEND_DEADLINE=14:00
USE_PLAYWRIGHT=false
